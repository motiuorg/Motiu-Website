---
// src/components/NetworkSection.astro
import ProjectCard from "./ProjectCard.astro";
import FeaturedCardGrid from "./FeaturedCardGrid.astro";
import type { Project, NetworkMeta } from "../content.config";

interface Props {
  networkId: "miceli" | "keras-buti";
  meta: NetworkMeta;
  projects: Project[];
}
const { networkId, meta, projects } = Astro.props;
const fmt = new Intl.NumberFormat("en-US", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });

// ProjectCard's props are title/subtitle/body/href, not this schema's name/locality/theme/summary/links —
// map them by hand. Link priority: own site, then the Regen Coordination page, then Karma GAP; a project
// with none of the three (rare, usually still-pending) just renders without a footer link.
function linkFor(p: Project) {
  if (p.links.web) return { href: p.links.web, label: "Visit site ↗" };
  if (p.links.rc_page) return { href: p.links.rc_page, label: "View on Regen Coordination ↗" };
  if (p.links.karma) return { href: p.links.karma, label: "View on Karma GAP ↗" };
  return { href: undefined, label: undefined };
}
function badgeFor(p: Project) {
  return p.status === "confirmed"
    ? { cls: "badge--success", label: "Confirmed" }
    : { cls: "badge--warning", label: "Pending" };
}

// Featured-first layout — the first project runs large (image left, content right), the rest fall
// into a compact grid below. The layout itself lives in FeaturedCardGrid (content-agnostic, no
// network-specific knowledge); this component's own job is just the header above it and mapping the
// cohort data shape onto ProjectCard's props.
const [featuredProject, ...restProjects] = projects;
const featuredLink = featuredProject ? linkFor(featuredProject) : null;
const featuredBadge = featuredProject ? badgeFor(featuredProject) : null;
---

<section class="network" data-network={networkId}>
  <header class="network-header">
    <p class="eyebrow">Network</p>
    <h2>{meta.name}</h2>
    <div class="meta-row">
      <span class="role">{meta.role}</span>
      <span class="contribution">Matching pool · {fmt.format(meta.contribution_eur)}</span>
      <span class="count">{projects.length} project{projects.length === 1 ? "" : "s"}</span>
    </div>
    <p class="summary">{meta.summary}</p>
  </header>

  <div class="network-grid-wrap">
    <FeaturedCardGrid>
      {featuredProject && featuredLink && featuredBadge && (
        <ProjectCard
          slot="featured"
          featured
          image={featuredProject.image}
          title={featuredProject.name}
          subtitle={`${featuredProject.locality} · ${featuredProject.theme}`}
          body={featuredProject.summary}
          href={featuredLink.href}
          external={true}
          linkLabel={featuredLink.label}
          mediaPillar="flow"
        >
          <span slot="badges" class={`badge ${featuredBadge.cls}`}>{featuredBadge.label}</span>
        </ProjectCard>
      )}
      {restProjects.map((p) => {
        const link = linkFor(p);
        const badge = badgeFor(p);
        return (
          <ProjectCard
            image={p.image}
            title={p.name}
            subtitle={`${p.locality} · ${p.theme}`}
            body={p.summary}
            href={link.href}
            external={true}
            linkLabel={link.label}
            mediaPillar="flow"
          >
            <span slot="badges" class={`badge ${badge.cls}`}>{badge.label}</span>
          </ProjectCard>
        );
      })}
    </FeaturedCardGrid>
  </div>
</section>

<style>
.network {
  padding: 3rem 2rem;
  border-top: 1px solid var(--umber);
}
.network-header {
  max-width: 60rem;
  margin: 0 auto 2rem;
}
.network-header h2 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  margin: 0.25rem 0 0.5rem;
}
.meta-row {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
  font-family: var(--mono);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rule);
  margin-bottom: 1rem;
}
/* Was font-family: var(--serif) — Averia, the opt-in display face — on a plain paragraph. Same
   violation as Tile's body copy; dropped for the same reason (see Typography: Averia is h1–h3
   .display only, never body text). */
.network-header .summary {
  font-size: 1.05rem;
  color: var(--umber);
  max-width: 50ch;
}
.network-grid-wrap {
  max-width: 80rem;
  margin: 0 auto;
}
</style>
