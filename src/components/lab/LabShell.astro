---
// LabShell.astro — persistent side-nav shell for /lab/*. Wraps the real
// site Layout (Nav + Footer stay, so you can always get back to the site)
// and adds a docs-style left rail driven by src/data/lab-nav.yaml.
import fs from "node:fs";
import path from "node:path";
import yaml from "js-yaml";
import Layout from "../Layout.astro";
import "../../styles/lab.css";

interface NavItem { slug: string; label: string }
interface NavGroup { label: string; items: NavItem[] }
const nav = (yaml.load(
  fs.readFileSync(path.join(process.cwd(), "src/data/lab-nav.yaml"), "utf8"),
) as { groups: NavGroup[] }).groups;

interface Props {
  title: string;
  current: string; // slug matching lab-nav.yaml, "" for the index
  intro?: string;
}
const { title, current, intro } = Astro.props;
const href = (slug: string) => (slug ? `/lab/${slug}/` : "/lab/");
---
<Layout title={`Lab — ${title}`} current="home" noindex={true}
  description={`Internal design-system reference: ${title}.`}>
  <div class="lab-shell">
    <nav class="lab-nav" aria-label="Lab sections">
      {nav.map((group) => (
        <div class="lab-nav__group">
          <p class="lab-nav__label">{group.label}</p>
          <ul class="lab-nav__list">
            {group.items.map((item) => (
              <li><a href={href(item.slug)} class:list={{ active: item.slug === current }}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <main class="lab-main">
      <h1>{title}</h1>
      {intro && <p class="lab-intro">{intro}</p>}
      <slot />
    </main>
  </div>
</Layout>
