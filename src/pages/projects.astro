---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PillarBadge from "../components/PillarBadge.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CardGrid from "../components/CardGrid.astro";
import CTABand from "../components/CTABand.astro";
import yaml from "js-yaml";
import fs from "node:fs";
import path from "node:path";

const projects = (yaml.load(fs.readFileSync(path.join(process.cwd(), "src/data/projects.yaml"), "utf8")) as any).projects;

// landing.yaml has hand-written, curated heading/name/excerpt copy for the projects it features
// on the homepage — prefer that here too, keyed by href, so the two pages show identical card
// copy instead of this page silently falling back to an auto-trimmed excerpt of the body. Only
// projects not featured on the homepage (currently just Bioregional Garden) use the fallback.
const landing = yaml.load(fs.readFileSync(path.join(process.cwd(), "src/data/landing.yaml"), "utf8")) as any;
const landingProjectByHref: Record<string, any> = Object.fromEntries(landing.projects.map((p: any) => [p.href, p]));

const excerpt = (body: string, max = 190) => {
  const first = (body ?? "").split(/\n\s*\n/)[0].replace(/\s+/g, " ").trim();
  if (first.length <= max) return first;
  return first.slice(0, first.lastIndexOf(" ", max)).trim() + "…";
};
const items = projects.map((p: any) => {
  const href = p.external ? p.href : `/projects/${p.slug}/`;
  const lp = landingProjectByHref[href];
  return {
    heading: lp?.heading ?? p.title,
    name: lp?.name ?? p.theme,
    excerpt: lp?.excerpt ?? excerpt(p.body),
    image: p.image,
    href,
    external: p.external,
    pillars: p.pillars,
  };
});
---
<Layout title="Projects" current="projects" description="Case studies from work Motiu has actually done — funding programs, network coordination, and territorial sensemaking.">
  <PageHero
    eyebrow="Projects"
    title="Our work"
    lede="Funding programs, network coordination, and territorial sensemaking across Catalonia and beyond — not aspirations, engagements we designed, ran, and handed over."
  />

  <section class="block block--alt">
    <div class="block__inner">
      <CardGrid>
        {items.map((it: any) => (
          <ProjectCard image={it.image} title={it.heading} subtitle={it.name} body={it.excerpt} href={it.href} external={it.external}>
            {it.pillars?.length > 0 && (
              <Fragment slot="badges">
                {it.pillars.map((k: string) => <PillarBadge pillar={k as any} />)}
              </Fragment>
            )}
          </ProjectCard>
        ))}
      </CardGrid>
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  .block { padding: var(--space-16) var(--gutter); }
  .block--alt { background: var(--surface-1); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .block__inner { max-width: var(--container-default); margin: 0 auto; }

  /* Project gallery grid now lives in CardGrid.astro (shared with index.astro). */

</style>
